# Semaphore UI on Railway — wrapper around the pinned upstream image.
#
# Why a wrapper at all (house style: bake constants, keep the deploy
# form minimal, and survive Railway's root-owned volumes):
# - PORT: Semaphore reads its HTTP port from SEMAPHORE_PORT only
#   (default :3000) and ignores Railway's generic PORT (verified in
#   semaphoreui/semaphore v2.20.23 util/config.go:683 — `Port
#   ListenPort ... env:"SEMAPHORE_PORT"`). entrypoint.sh exports
#   SEMAPHORE_PORT=$PORT on every boot. Fail loud if the remap did
#   not land — a server listening on the wrong port is a silent dead
#   deploy.
# - USER root: the published image runs as USER 1001 (verified via
#   the Docker Hub registry API 2026-11-12) and its entrypoint
#   creates /etc/semaphore + /var/lib/semaphore. Railway mounts
#   volumes root-owned, so the stock user cannot write to a fresh
#   volume and the first boot would fail. The wrapper runs as root;
#   the semaphore binary itself needs no special user.
# - DATA: one Railway volume at /data. The wrapper points both
#   persistent dirs at it via the image's own variables:
#   SEMAPHORE_CONFIG_PATH=/data/config (config.json, generated by
#   `semaphore setup` on first boot — holds the cookie hash and
#   encryption keys, so it MUST survive redeploys or sessions and
#   stored credentials break) and SEMAPHORE_DB_PATH=/data/db
#   (SQLite database.sqlite; the image's server-wrapper derives the
#   sqlite path from this dir). Task working dirs stay ephemeral
#   under /tmp/semaphore (SEMAPHORE_TMP_PATH default).
# - ADMIN: the image's own server-wrapper seeds the admin account on
#   first boot from SEMAPHORE_ADMIN / SEMAPHORE_ADMIN_PASSWORD /
#   SEMAPHORE_ADMIN_EMAIL / SEMAPHORE_ADMIN_NAME (it feeds them to
#   `semaphore setup -` on stdin when config.json does not exist
#   yet). Username and contact details are baked; the password is a
#   generated deploy-form variable (SEMAPHORE_ADMIN_PASSWORD=
#   ${{secret(16)}}). Seeding happens exactly once per volume — a
#   later change to the variable does not change the password.
# - ACCESS KEY ENCRYPTION: stored SSH keys/passwords are encrypted
#   with SEMAPHORE_ACCESS_KEY_ENCRYPTION (base64 of 32 random bytes;
#   validated by util/config.go validateAccessKeyEncryption). It is
#   optional at boot (unset = passthrough, secrets stored in plain
#   text), which is not acceptable for a template that stores
#   credentials. The deploy form must NOT ask for it (users cannot
#   be expected to supply base64), so entrypoint.sh generates it
#   once per volume (head -c32 /dev/urandom | base64, stored at
#   /data/config/access-key-encryption) and exports it on every boot.
#   Stable across redeploys, never in the repo or the deploy form.
# - PUBLIC URL: derived at boot from the live RAILWAY_PUBLIC_DOMAIN
#   (SEMAPHORE_WEB_ROOT) — never a template-expression variable. A
#   https://${{RAILWAY_PUBLIC_DOMAIN}} default resolves to a bare
#   "https://" on first deploy (no domain exists yet); Semaphore
#   reads env over config.json on every boot (util/config.go
#   loadConfigFile -> loadConfigEnvironment -> loadConfigDefaults),
#   so the boot-derived value always wins. Used for links in
#   notifications and task output; the UI itself is served at /.
# - WHAT'S IN THE IMAGE: the official image ships the whole runner
#   toolchain — ansible 13.5.0 in a venv (on PATH), OpenTofu 1.11.0,
#   Terraform 1.11.3, Terragrunt 0.78.0 — so Ansible/Terraform task
#   templates run with no extra setup. No Docker socket, no GPU, no
#   TUN, no systemd: nothing in the skill's hard-reject list.
# - HEALTHCHECK: upstream's own /api/ping (public, returns "pong",
#   api/router.go:155-157) — no auth needed, so it is the platform
#   probe. No Docker HEALTHCHECK: rely on Railway's external
#   healthcheckPath.
# - ENTRYPOINT: the image's CMD is /usr/local/bin/server-wrapper
#   under tini. The wrapper entrypoint execs exactly that
#   (tini -- server-wrapper) after the remap/seed steps, so the
#   first-run setup flow runs untouched.
#
# Upstream: Semaphore UI v2.20.23 by semaphoreui (MIT), image pinned
# by manifest digest, verified 2026-11-12 via the Docker Hub API
# (tag v2.20.23, manifest list digest below; amd64 manifest
# sha256:b4252b9207e2012d52dbb2a2cd1adbd3c9b6b9c668fdf67a42bd7338907363a8).
# NOTE: the FROM uses the digest WITHOUT a tag — Railpack 0.43.0
# fails to detect a Dockerfile whose FROM carries both a tag and a
# digest (redeploys die in the plan phase with "could not determine
# how to build the app"); the digest-only form builds under both
# the Dockerfile builder and Railpack (verified 2026-11-05 —
# TimeTagger's digest-only FROM is the precedent).

# semaphoreui/semaphore:v2.20.23
FROM semaphoreui/semaphore@sha256:00e6733dbca9a2bddf77e048f34f9002027c8a6f549a8cde18d13101e84a19c3

USER root

COPY entrypoint.sh /railway-entrypoint.sh
RUN chmod +x /railway-entrypoint.sh

# Baked constants (see header): SQLite on the volume, config + DB
# paths on the volume, admin identity. The HTTP port is mapped from
# Railway's PORT by the entrypoint on every boot; the access-key
# encryption key is generated once per volume by the entrypoint.
ENV SEMAPHORE_DB_DIALECT=sqlite \
    SEMAPHORE_CONFIG_PATH=/data/config \
    SEMAPHORE_DB_PATH=/data/db \
    SEMAPHORE_ADMIN=admin \
    SEMAPHORE_ADMIN_EMAIL=admin@localhost \
    SEMAPHORE_ADMIN_NAME="Semaphore Admin"

# Documentation only: Railway routes to $PORT at runtime (see
# entrypoint.sh); 3000 is the upstream default the image would use
# without the wrapper's remap.
EXPOSE 3000

ENTRYPOINT ["/bin/sh", "/railway-entrypoint.sh"]
