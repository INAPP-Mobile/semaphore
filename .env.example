# Semaphore UI on Railway — environment reference
#
# Copy to .env only for local runs. On Railway the deploy form sets
# SEMAPHORE_ADMIN_PASSWORD (generated); everything else is baked
# into the image or derived at boot by entrypoint.sh. Values below
# are the defaults this template ships.

# --- Deploy form (one field) ---
# Admin password for the seeded admin account (username admin).
# Generated per deploy; seeded exactly once per volume.
SEMAPHORE_ADMIN_PASSWORD=your-generated-admin-password

# --- Baked into the image (Dockerfile ENV) ---
# Database dialect: sqlite — single service, no companion database.
SEMAPHORE_DB_DIALECT=sqlite
# Persistent dirs on the /data volume: config.json (cookie hash +
# encryption keys) and database.sqlite. Both must survive redeploys.
SEMAPHORE_CONFIG_PATH=/data/config
SEMAPHORE_DB_PATH=/data/db
# Seeded admin identity (first boot only).
SEMAPHORE_ADMIN=admin
SEMAPHORE_ADMIN_EMAIL=admin@localhost
SEMAPHORE_ADMIN_NAME=Semaphore Admin

# --- Derived at boot by entrypoint.sh (do not set) ---
# HTTP port, from Railway's injected PORT.
SEMAPHORE_PORT=3000
# Access-key encryption key (base64 of 32 random bytes), generated
# once per volume at /data/config/access-key-encryption. Unset would
# mean stored credentials are kept in plain text.
SEMAPHORE_ACCESS_KEY_ENCRYPTION=your-base64-32-byte-key
# Public URL, from the live Railway domain.
SEMAPHORE_WEB_ROOT=https://your-app.up.railway.app

# --- Optional upstream settings (unset by default) ---
# SEMAPHORE_DB_HOST — sqlite file path; the image's server-wrapper
#   derives it from SEMAPHORE_DB_PATH (/data/db/database.sqlite).
# SEMAPHORE_DB_USER / SEMAPHORE_DB_PASS / SEMAPHORE_DB — only for
#   mysql/postgres dialects; unused with sqlite.
# SEMAPHORE_TMP_PATH — task working dirs; default /tmp/semaphore.
# SEMAPHORE_COOKIE_HASH / SEMAPHORE_COOKIE_ENCRYPTION — generated
#   by `semaphore setup` into config.json on first boot.
# SEMAPHORE_OPTION_ENCRYPTION — separate key for DB options (JWT);
#   falls back to the access key when unset.
# SEMAPHORE_EMAIL_ALERT / SEMAPHORE_EMAIL_SENDER /
#   SEMAPHORE_EMAIL_HOST / SEMAPHORE_EMAIL_PORT /
#   SEMAPHORE_EMAIL_USERNAME / SEMAPHORE_EMAIL_PASSWORD /
#   SEMAPHORE_EMAIL_SECURE — SMTP notifications (off by default).
# SEMAPHORE_LDAP_ACTIVATED / SEMAPHORE_LDAP_HOST /
#   SEMAPHORE_LDAP_PORT / SEMAPHORE_LDAP_DN_BIND /
#   SEMAPHORE_LDAP_PASSWORD / SEMAPHORE_LDAP_DN_SEARCH /
#   SEMAPHORE_LDAP_SEARCH_FILTER — LDAP login (off by default).
# SEMAPHORE_GIT_CLIENT — go_git or cmd_git; default cmd_git.
# SEMAPHORE_HOME_DIR_MODE — template_home (default), project_home,
#   or user_home; controls HOME isolation for task runs.
# SEMAPHORE_PLAYBOOK_PATH — where playbooks are staged for tasks.
# SEMAPHORE_WEB_ROOT — see above; set manually only for a custom
#   domain.
